<Window x:Class="DesktopRider.App.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ai="clr-namespace:DesktopRider.AI;assembly=DesktopRider.AI"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=ai:ConversationViewModel}"
        Title="Talk to the rider"
        Width="396"
        Height="496"
        Left="-32000"
        Top="-32000"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <!--
        The compact conversation window, in the same dark rounded style as the rider's menu. It opens beside the rider
        when the rider is clicked and closes the same way, with the X, or with Esc. Closing it does not stop a reply:
        the rest appears in the rider's speech bubble.
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="ShowWhenTrue" />
        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />

        <!-- One line of the conversation. The words can be selected and copied. -->
        <DataTemplate DataType="{x:Type ai:ConversationLine}">
            <Border x:Name="Balloon"
                    Margin="0,4,44,4"
                    Padding="11,7"
                    CornerRadius="12,12,12,3"
                    Background="{StaticResource SurfaceRaised}"
                    HorizontalAlignment="Left">
                <TextBox x:Name="Words"
                         Text="{Binding Text, Mode=OneWay}"
                         IsReadOnly="True"
                         IsTabStop="False"
                         TextWrapping="Wrap"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="0"
                         FontSize="14"
                         SelectionBrush="{StaticResource FaintInk}"
                         Foreground="{StaticResource Ink}" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Speaker}" Value="{x:Static ai:Speaker.User}">
                    <Setter TargetName="Balloon" Property="HorizontalAlignment" Value="Right" />
                    <Setter TargetName="Balloon" Property="Margin" Value="44,4,0,4" />
                    <Setter TargetName="Balloon" Property="CornerRadius" Value="12,12,3,12" />
                    <Setter TargetName="Balloon" Property="Background" Value="{StaticResource SurfaceStrong}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Speaker}" Value="{x:Static ai:Speaker.Notice}">
                    <Setter TargetName="Balloon" Property="HorizontalAlignment" Value="Stretch" />
                    <Setter TargetName="Balloon" Property="Margin" Value="0,4" />
                    <Setter TargetName="Balloon" Property="CornerRadius" Value="6" />
                    <Setter TargetName="Balloon" Property="Background" Value="{StaticResource NoticeSurface}" />
                    <Setter TargetName="Balloon" Property="BorderBrush" Value="{StaticResource NoticeEdge}" />
                    <Setter TargetName="Balloon" Property="BorderThickness" Value="1" />
                    <Setter TargetName="Words" Property="FontSize" Value="13" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Border CornerRadius="8" Background="{StaticResource Surface}" Effect="{StaticResource SoftShadow}" />
        <Border CornerRadius="8" Background="{StaticResource Surface}" BorderBrush="{StaticResource Edge}" BorderThickness="1">
            <Grid Margin="12,8,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Heading -->
                <DockPanel Grid.Row="0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" FontFamily="{StaticResource GlyphFont}" Content="&#xE711;" Click="OnCloseClick"
                            ToolTip="Close (Esc). The rider carries on in a speech bubble." />
                    <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="Clear" Command="{Binding ClearCommand}"
                            ToolTip="Start a fresh conversation. The saved copy of this one is deleted too." />
                    <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="Bubbles" Click="OnBubblesClick"
                            ToolTip="Switch to typing in a small bubble below the rider" />
                    <TextBlock Text="Talk to the rider" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                </DockPanel>

                <!-- Which AI model is answering, and whether it can be reached -->
                <DockPanel Grid.Row="1" Margin="0,4,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,2,0">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#FF8A8A8A" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="#FF6CCB5F" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConnectionText}" Value="{x:Static ai:ConversationViewModel.NotConnectedText}">
                                            <Setter Property="Fill" Value="#FFFF6B6B" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionText}" FontSize="12" Foreground="{StaticResource SoftInk}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="ModelButton" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="-8,0,0,0" Click="OnModelClick"
                            ToolTip="Choose which AI model the rider uses">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="AI model: " Foreground="{StaticResource FaintInk}" />
                            <TextBlock Text="{Binding ModelText}" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource GlyphFont}" FontSize="9" Margin="6,1,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </DockPanel>

                <!-- What to do when the AI is not ready -->
                <Border Grid.Row="2" Margin="0,8,0,0" Padding="10,8" CornerRadius="6" Background="{StaticResource NoticeSurface}" BorderBrush="{StaticResource NoticeEdge}" BorderThickness="1"
                        Visibility="{Binding HasAdvice, Converter={StaticResource ShowWhenTrue}}">
                    <StackPanel>
                        <TextBlock Text="{Binding Advice}" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource Ink}" />
                        <Button Style="{StaticResource QuietButton}" Content="Check again" Command="{Binding CheckConnectionCommand}"
                                HorizontalAlignment="Left" Margin="-8,4,0,-3" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                    </StackPanel>
                </Border>

                <!-- The conversation -->
                <Grid Grid.Row="3" Margin="0,8,0,0">
                    <ScrollViewer x:Name="History" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                                  ScrollChanged="OnHistoryScrollChanged">
                        <ItemsControl ItemsSource="{Binding Lines}" Margin="0,0,6,0" Focusable="False" />
                    </ScrollViewer>
                    <TextBlock Text="Type a message below and press Enter. The rider will answer here."
                               TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="28,0"
                               FontSize="13" Foreground="{StaticResource FaintInk}" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Lines.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Shown while the AI is working -->
                <StackPanel Grid.Row="4" Margin="0,6,0,0" Visibility="{Binding IsBusy, Converter={StaticResource ShowWhenTrue}}">
                    <TextBlock Text="{Binding ProcessingText}" FontSize="12" Foreground="{StaticResource SoftInk}" />
                    <ProgressBar IsIndeterminate="{Binding IsBusy}" Height="3" Margin="0,4,0,0" BorderThickness="0" Background="{StaticResource Edge}" Foreground="{StaticResource SoftInk}" />
                </StackPanel>

                <!-- Typing -->
                <Border Grid.Row="5" Margin="0,8,0,0" CornerRadius="20" Background="{StaticResource SurfaceRaised}" Padding="14,4,4,4">
                    <DockPanel>
                        <Grid DockPanel.Dock="Right" Margin="6,0,0,0" VerticalAlignment="Bottom">
                            <Button Style="{StaticResource RoundButton}" Content="&#xE724;" Command="{Binding SendCommand}" ToolTip="Send (Enter)" />
                            <Button Style="{StaticResource RoundButton}" Content="&#xE71A;" Command="{Binding StopCommand}" ToolTip="Stop the rider's reply"
                                    Visibility="{Binding IsBusy, Converter={StaticResource ShowWhenTrue}}" />
                        </Grid>
                        <Grid VerticalAlignment="Center">
                            <TextBox x:Name="Input"
                                     Text="{Binding Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MaxLength="4000"
                                     MaxHeight="84"
                                     VerticalScrollBarVisibility="Auto"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="14"
                                     Foreground="{StaticResource Ink}"
                                     CaretBrush="{StaticResource Ink}"
                                     SelectionBrush="{StaticResource FaintInk}"
                                     PreviewKeyDown="OnInputPreviewKeyDown" />
                            <TextBlock Text="Type a message" FontSize="14" Foreground="{StaticResource FaintInk}" Margin="3,0,0,0" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Draft}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
