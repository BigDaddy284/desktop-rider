<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        The look shared by the rider's menu, the conversation window and the bubbles: the dark, rounded style of
        Windows 11's own right-click menus. Neutral greys only; no colours are invented for the rider.
    -->
    <SolidColorBrush x:Key="Surface" Color="#FF2C2C2C" />
    <SolidColorBrush x:Key="SurfaceRaised" Color="#FF383838" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#FF3D3D3D" />
    <SolidColorBrush x:Key="SurfaceStrong" Color="#FF505050" />
    <SolidColorBrush x:Key="Edge" Color="#FF454545" />
    <SolidColorBrush x:Key="Ink" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SoftInk" Color="#FFCFCFCF" />
    <SolidColorBrush x:Key="FaintInk" Color="#FF9A9A9A" />
    <SolidColorBrush x:Key="NoticeSurface" Color="#FF433519" />
    <SolidColorBrush x:Key="NoticeEdge" Color="#FF8A6A1C" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="GlyphFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- The soft shadow drawn behind a menu, window or bubble. Kept on its own shape so the words in front stay sharp. -->
    <DropShadowEffect x:Key="SoftShadow" BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.35" />

    <!-- Menus -->
    <Style TargetType="ContextMenu">
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinWidth" Value="220" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Grid Margin="10">
                        <Border CornerRadius="8" Background="{StaticResource Surface}" Effect="{StaticResource SoftShadow}" />
                        <Border CornerRadius="8" Background="{StaticResource Surface}" BorderBrush="{StaticResource Edge}" BorderThickness="1" Padding="0,4">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="0,4" Background="{StaticResource Edge}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Set Icon to a character from the Windows icon font to show a picture beside the words. -->
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Face" Margin="4,1" Padding="10,7,8,7" CornerRadius="4" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="Picture" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                  TextElement.FontFamily="{StaticResource GlyphFont}" TextElement.FontSize="16" />
                                <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="{StaticResource GlyphFont}" FontSize="14"
                                           VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{StaticResource FaintInk}"
                                           FontSize="12" Margin="24,0,0,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="Arrow" Grid.Column="3" Text="&#xE76C;" FontFamily="{StaticResource GlyphFont}" FontSize="10"
                                           Foreground="{StaticResource SoftInk}" Margin="24,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-6" VerticalOffset="-14" AllowsTransparency="True" Focusable="False"
                               PopupAnimation="Fade" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Grid Margin="10">
                                <Border CornerRadius="8" Background="{StaticResource Surface}" Effect="{StaticResource SoftShadow}" />
                                <Border CornerRadius="8" Background="{StaticResource Surface}" BorderBrush="{StaticResource Edge}" BorderThickness="1" Padding="0,4" MinWidth="180">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="420" CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Picture" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Face" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A slim scroll bar that suits the dark surface. -->
    <Style x:Key="SlimScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border CornerRadius="3" Background="#FF6E6E6E" Margin="1,0" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SlimScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A quiet button that looks like a word or small picture you can click. -->
    <Style x:Key="QuietButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource SoftInk}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource SurfaceHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The round button that sends a message, or stops a reply. Its content is a character from the Windows icon font. -->
    <Style x:Key="RoundButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Surface}" />
        <Setter Property="Background" Value="{StaticResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource GlyphFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="16">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource SoftInk}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
