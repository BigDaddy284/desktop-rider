<Window x:Class="DesktopRider.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ai="clr-namespace:DesktopRider.AI;assembly=DesktopRider.AI"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=ai:RiderSettingsViewModel}"
        Title="Rider settings"
        Width="464"
        Height="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <!--
        The rider's settings, in the same dark rounded style as the conversation window. Every choice is saved the
        moment it is made, so there is no Save button. The window can be dragged by its heading and closes with
        the X or Esc.
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="ShowWhenTrue" />
        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="Question" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource SoftInk}" />
            <Setter Property="Margin" Value="0,12,0,4" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Explanation" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource FaintInk}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Choice" TargetType="RadioButton">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
            <Setter Property="SelectionBrush" Value="{StaticResource FaintInk}" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FF323232" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12,14,14" />
            <Setter Property="Margin" Value="0,0,6,10" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Border CornerRadius="8" Background="{StaticResource Surface}" Effect="{StaticResource SoftShadow}" />
        <Border CornerRadius="8" Background="{StaticResource Surface}" BorderBrush="{StaticResource Edge}" BorderThickness="1">
            <Grid Margin="12,8,6,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Heading. Dragging it moves the window. -->
                <DockPanel Grid.Row="0" Margin="0,0,6,6" Background="Transparent" MouseLeftButtonDown="OnHeadingMouseDown">
                    <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" FontFamily="{StaticResource GlyphFont}" Content="&#xE711;" Click="OnCloseClick"
                            ToolTip="Close (Esc). Your choices are already saved." />
                    <StackPanel>
                        <TextBlock Text="Rider settings" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                        <TextBlock Text="Changes are saved as you make them." Style="{StaticResource Explanation}" />
                    </StackPanel>
                </DockPanel>

                <!-- Shown only if a change could not be saved -->
                <Border Grid.Row="1" Margin="0,0,6,8" Padding="10,8" CornerRadius="6" Background="{StaticResource NoticeSurface}" BorderBrush="{StaticResource NoticeEdge}" BorderThickness="1"
                        Visibility="{Binding HasProblem, Converter={StaticResource ShowWhenTrue}}">
                    <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource Ink}" />
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel>

                        <!-- Personality -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Personality" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Choose how the rider talks to you." Style="{StaticResource Explanation}" />

                                <TextBlock Text="How should the rider talk?" Style="{StaticResource Question}" />
                                <StackPanel IsEnabled="{Binding UsingBuiltInPersonality}">
                                    <RadioButton GroupName="Tone" Style="{StaticResource Choice}" IsChecked="{Binding ToneCheeky, Mode=TwoWay}"
                                                 Content="Cheeky: friendly, with the odd joke" />
                                    <RadioButton GroupName="Tone" Style="{StaticResource Choice}" IsChecked="{Binding ToneFriendly, Mode=TwoWay}"
                                                 Content="Friendly: warm and encouraging" />
                                    <RadioButton GroupName="Tone" Style="{StaticResource Choice}" IsChecked="{Binding ToneSerious, Mode=TwoWay}"
                                                 Content="Serious: calm and to the point" />
                                </StackPanel>

                                <TextBlock Text="How much should the rider say?" Style="{StaticResource Question}" />
                                <RadioButton GroupName="Length" Style="{StaticResource Choice}" IsChecked="{Binding ShortReplies, Mode=TwoWay}"
                                             Content="Short replies that fit in a speech bubble" />
                                <RadioButton GroupName="Length" Style="{StaticResource Choice}" IsChecked="{Binding DetailedReplies, Mode=TwoWay}"
                                             Content="Longer, more detailed replies" />

                                <TextBlock Text="What should the rider call you?" Style="{StaticResource Question}" />
                                <TextBox x:Name="UserNameBox" Style="{StaticResource Field}" MaxLength="40" Width="220" HorizontalAlignment="Left"
                                         Text="{Binding UserName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Text="Leave this empty and the rider will not use a name." Style="{StaticResource Explanation}" Margin="0,4,0,0" />

                                <TextBlock Text="Describe the rider in your own words (optional)" Style="{StaticResource Question}" />
                                <TextBox x:Name="OwnPersonalityBox" Style="{StaticResource Field}" MaxLength="2000" Height="72"
                                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         Text="{Binding OwnPersonality, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Style="{StaticResource Explanation}" Margin="0,4,0,0"
                                           Text="For example: &quot;You are a grumpy old race mechanic with a heart of gold.&quot; While there is something written here it replaces the choice of how the rider talks." />
                                <Button Style="{StaticResource QuietButton}" Content="Go back to the built-in rider" Command="{Binding UseBuiltInPersonalityCommand}"
                                        HorizontalAlignment="Left" Margin="-8,4,0,-4"
                                        Visibility="{Binding UsingOwnPersonality, Converter={StaticResource ShowWhenTrue}}" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
