<Window x:Class="DesktopRider.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ai="clr-namespace:DesktopRider.AI;assembly=DesktopRider.AI"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=ai:RiderSettingsViewModel}"
        Title="Rider settings"
        Width="464"
        Height="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <!--
        The rider's settings, in the same dark rounded style as the conversation window. Every choice is saved the
        moment it is made, so there is no Save button. The window can be dragged by its heading and closes with
        the X or Esc.
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="ShowWhenTrue" />
        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="Question" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource SoftInk}" />
            <Setter Property="Margin" Value="0,12,0,4" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Explanation" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource FaintInk}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Choice" TargetType="RadioButton">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
            <Setter Property="SelectionBrush" Value="{StaticResource FaintInk}" />
        </Style>
        <!-- A button with an outline, for actions such as deleting. -->
        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{StaticResource SurfaceStrong}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{StaticResource SurfaceStrong}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FF323232" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12,14,14" />
            <Setter Property="Margin" Value="0,0,6,10" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Border CornerRadius="8" Background="{StaticResource Surface}" Effect="{StaticResource SoftShadow}" />
        <Border CornerRadius="8" Background="{StaticResource Surface}" BorderBrush="{StaticResource Edge}" BorderThickness="1">
            <Grid Margin="12,8,6,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Heading. Dragging it moves the window. -->
                <DockPanel Grid.Row="0" Margin="0,0,6,6" Background="Transparent" MouseLeftButtonDown="OnHeadingMouseDown">
                    <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" FontFamily="{StaticResource GlyphFont}" Content="&#xE711;" Click="OnCloseClick"
                            ToolTip="Close (Esc). Your choices are already saved." />
                    <StackPanel>
                        <TextBlock Text="Rider settings" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                        <TextBlock Text="Changes are saved as you make them." Style="{StaticResource Explanation}" />
                    </StackPanel>
                </DockPanel>

                <!-- Shown only if a change could not be saved -->
                <Border Grid.Row="1" Margin="0,0,6,8" Padding="10,8" CornerRadius="6" Background="{StaticResource NoticeSurface}" BorderBrush="{StaticResource NoticeEdge}" BorderThickness="1"
                        Visibility="{Binding HasProblem, Converter={StaticResource ShowWhenTrue}}">
                    <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource Ink}" />
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel>

                        <!-- Personality -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Personality" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Choose how the rider talks to you." Style="{StaticResource Explanation}" />

                                <TextBlock Text="How should the rider talk?" Style="{StaticResource Question}" />
                                <StackPanel IsEnabled="{Binding UsingBuiltInPersonality}">
                                    <RadioButton GroupName="Tone" Style="{StaticResource Choice}" IsChecked="{Binding ToneCheeky, Mode=TwoWay}"
                                                 Content="Cheeky: friendly, with the odd joke" />
                                    <RadioButton GroupName="Tone" Style="{StaticResource Choice}" IsChecked="{Binding ToneFriendly, Mode=TwoWay}"
                                                 Content="Friendly: warm and encouraging" />
                                    <RadioButton GroupName="Tone" Style="{StaticResource Choice}" IsChecked="{Binding ToneSerious, Mode=TwoWay}"
                                                 Content="Serious: calm and to the point" />
                                </StackPanel>

                                <TextBlock Text="How much should the rider say?" Style="{StaticResource Question}" />
                                <RadioButton GroupName="Length" Style="{StaticResource Choice}" IsChecked="{Binding ShortReplies, Mode=TwoWay}"
                                             Content="Short replies that fit in a speech bubble" />
                                <RadioButton GroupName="Length" Style="{StaticResource Choice}" IsChecked="{Binding DetailedReplies, Mode=TwoWay}"
                                             Content="Longer, more detailed replies" />

                                <TextBlock Text="What should the rider call you?" Style="{StaticResource Question}" />
                                <TextBox x:Name="UserNameBox" Style="{StaticResource Field}" MaxLength="40" Width="220" HorizontalAlignment="Left"
                                         Text="{Binding UserName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Text="Leave this empty and the rider will not use a name." Style="{StaticResource Explanation}" Margin="0,4,0,0" />

                                <TextBlock Text="Describe the rider in your own words (optional)" Style="{StaticResource Question}" />
                                <TextBox x:Name="OwnPersonalityBox" Style="{StaticResource Field}" MaxLength="2000" Height="72"
                                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         Text="{Binding OwnPersonality, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Style="{StaticResource Explanation}" Margin="0,4,0,0"
                                           Text="For example: &quot;You are a grumpy old race mechanic with a heart of gold.&quot; While there is something written here it replaces the choice of how the rider talks." />
                                <Button Style="{StaticResource QuietButton}" Content="Go back to the built-in rider" Command="{Binding UseBuiltInPersonalityCommand}"
                                        HorizontalAlignment="Left" Margin="-8,4,0,-4"
                                        Visibility="{Binding UsingOwnPersonality, Converter={StaticResource ShowWhenTrue}}" />
                            </StackPanel>
                        </Border>

                        <!-- Memory -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Memory" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Everything the rider remembers is kept on this computer only. Nothing is sent anywhere else." Style="{StaticResource Explanation}" />

                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding KeepConversations, Mode=TwoWay}"
                                          Content="Keep our conversation for next time" />
                                <TextBlock Style="{StaticResource Explanation}" Margin="0,4,0,0"
                                           Text="When this is on, the conversation is still there after you close and reopen Desktop Rider. Switching it off deletes the saved copy." />

                                <StackPanel IsEnabled="{Binding KeepConversations}">
                                    <TextBlock Text="How long should conversations be kept?" Style="{StaticResource Question}" />
                                    <RadioButton GroupName="Keep" Style="{StaticResource Choice}" IsChecked="{Binding KeepOneWeek, Mode=TwoWay}" Content="One week" />
                                    <RadioButton GroupName="Keep" Style="{StaticResource Choice}" IsChecked="{Binding KeepOneMonth, Mode=TwoWay}" Content="One month" />
                                    <RadioButton GroupName="Keep" Style="{StaticResource Choice}" IsChecked="{Binding KeepThreeMonths, Mode=TwoWay}" Content="Three months" />
                                    <RadioButton GroupName="Keep" Style="{StaticResource Choice}" IsChecked="{Binding KeepOneYear, Mode=TwoWay}" Content="One year" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Style="{StaticResource PlainButton}" Content="Delete the conversation" Command="{Binding DeleteConversationCommand}"
                                            ToolTip="Clears the conversation and deletes the saved copy from this computer" />
                                    <TextBlock Text="{Binding ConversationMessage}" Style="{StaticResource Explanation}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>

                                <Border Height="1" Background="{StaticResource Edge}" Margin="0,14,0,6" />

                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding RememberThings, Mode=TwoWay}"
                                          Content="Let the rider remember things about me" />
                                <TextBlock Style="{StaticResource Explanation}" Margin="0,4,0,0"
                                           Text="Say &quot;remember that…&quot; in a conversation, or add something below. The rider only remembers what you ask it to. Switching this off stops the rider using what it remembers, without deleting it." />

                                <TextBlock Text="What the rider remembers" Style="{StaticResource Question}" />
                                <TextBlock Text="Nothing yet." Style="{StaticResource Explanation}"
                                           Visibility="{Binding HasNoNotes, Converter={StaticResource ShowWhenTrue}}" />
                                <ItemsControl ItemsSource="{Binding Notes}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type ai:MemoryNoteItem}">
                                            <Border Background="{StaticResource SurfaceRaised}" CornerRadius="6" Padding="10,4,4,4" Margin="0,3,0,0">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="Forget" Command="{Binding ForgetCommand}"
                                                            VerticalAlignment="Top" ToolTip="Delete this from the rider's memory" />
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <DockPanel Margin="0,8,0,0" IsEnabled="{Binding RememberThings}">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource PlainButton}" Content="Add" Command="{Binding AddNoteCommand}" Margin="8,0,0,0" />
                                    <TextBox x:Name="NewNoteBox" Style="{StaticResource Field}" MaxLength="200"
                                             Text="{Binding NewNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="For example: My bike is a 250 two-stroke"
                                             KeyDown="OnNewNoteKeyDown" />
                                </DockPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Style="{StaticResource PlainButton}" Content="Forget everything" Command="{Binding ForgetEverythingCommand}"
                                            ToolTip="Deletes everything the rider remembers about you from this computer" />
                                    <TextBlock Text="{Binding MemoryMessage}" Style="{StaticResource Explanation}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- The rider speaking first -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Comments from the rider" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="The rider normally only speaks when you talk to it." Style="{StaticResource Explanation}" />

                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding RiderSpeaksFirst, Mode=TwoWay}"
                                          Content="Let the rider start conversations" />
                                <TextBlock Style="{StaticResource Explanation}" Margin="0,4,0,0"
                                           Text="When this is on, the rider says something of its own now and then: a remark about bikes, a tip, or an offer of help. It uses your AI model to think of it, so the AI must be connected. If you ignore it a few times it stops until you next talk to it. While this is off, Desktop Rider never contacts the AI by itself." />

                                <StackPanel IsEnabled="{Binding RiderSpeaksFirst}">
                                    <TextBlock Text="How often, when you have not been talking?" Style="{StaticResource Question}" />
                                    <RadioButton GroupName="Often" Style="{StaticResource Choice}" IsChecked="{Binding Every15Minutes, Mode=TwoWay}" Content="About every 15 minutes" />
                                    <RadioButton GroupName="Often" Style="{StaticResource Choice}" IsChecked="{Binding Every30Minutes, Mode=TwoWay}" Content="About every 30 minutes" />
                                    <RadioButton GroupName="Often" Style="{StaticResource Choice}" IsChecked="{Binding EveryHour, Mode=TwoWay}" Content="About every hour" />
                                    <RadioButton GroupName="Often" Style="{StaticResource Choice}" IsChecked="{Binding EveryTwoHours, Mode=TwoWay}" Content="About every two hours" />

                                    <CheckBox Style="{StaticResource Switch}" Margin="0,14,0,0" IsChecked="{Binding QuietHoursOn, Mode=TwoWay}"
                                              Content="Quiet hours: never speak first between these times" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" IsEnabled="{Binding QuietHoursOn}">
                                        <TextBlock Text="From" FontSize="13" Foreground="{StaticResource SoftInk}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBox x:Name="QuietFromBox" Style="{StaticResource Field}" Width="64" MaxLength="8"
                                                 Text="{Binding QuietFrom, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock Text="until" FontSize="13" Foreground="{StaticResource SoftInk}" VerticalAlignment="Center" Margin="10,0,8,0" />
                                        <TextBox x:Name="QuietUntilBox" Style="{StaticResource Field}" Width="64" MaxLength="8"
                                                 Text="{Binding QuietUntil, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding QuietHoursMessage}" Style="{StaticResource Explanation}" Margin="0,4,0,0" />
                                </StackPanel>

                                <TextBlock Style="{StaticResource Explanation}" Margin="0,10,0,0"
                                           Text="To hush the rider for a while, right-click it and choose &quot;Keep the rider quiet for an hour&quot;." />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
