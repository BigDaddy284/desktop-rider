<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>DesktopRider</AssemblyName>
    <RootNamespace>DesktopRider.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DesktopRider.Animation\DesktopRider.Animation.csproj" />
    <ProjectReference Include="..\DesktopRider.Core\DesktopRider.Core.csproj" />
    <ProjectReference Include="..\DesktopRider.Desktop\DesktopRider.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The rider's sprite sheets travel with the program, in an Assets folder beside it. -->
    <Content Include="..\..\Assets\Sprites\**\*.png;..\..\Assets\Sprites\**\*.json" Link="Assets\Sprites\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
