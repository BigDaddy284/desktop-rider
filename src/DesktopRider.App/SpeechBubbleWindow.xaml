<Window x:Class="DesktopRider.App.SpeechBubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ai="clr-namespace:DesktopRider.AI;assembly=DesktopRider.AI"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=ai:SpeechBubbleViewModel}"
        Title="Desktop Rider"
        Left="-32000"
        Top="-32000"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}">
    <!--
        The rider's speech bubble, in the same dark rounded style as the menu. Only the bubble itself is drawn,
        so clicks around it reach whatever is behind. It never takes the keyboard away from what the user is doing.
    -->
    <StackPanel Margin="12,10,12,2" Cursor="Hand" MouseLeftButtonUp="OnBubbleClick" ToolTip="Click to open the whole conversation">
        <Grid>
            <Border CornerRadius="14" Background="{StaticResource Surface}" Effect="{StaticResource SoftShadow}" />
            <Border CornerRadius="14" Background="{StaticResource Surface}" BorderBrush="{StaticResource Edge}" BorderThickness="1" Padding="14,10" MinWidth="72" MaxWidth="320">
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource Ink}" />
            </Border>
        </Grid>
        <!-- The tail, pointing down at the rider. Hidden when the bubble has had to go beside or below. -->
        <Path x:Name="Tail" Data="M 0,0 L 10,11 L 20,0" Fill="{StaticResource Surface}" Stroke="{StaticResource Edge}" StrokeThickness="1" StrokeLineJoin="Round"
              HorizontalAlignment="Center" Margin="0,-1,0,0" />
    </StackPanel>
</Window>
