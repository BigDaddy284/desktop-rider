<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <!-- Test names use underscores for readability, and test code does not need high-performance logging calls. -->
    <NoWarn>$(NoWarn);CA1707;CA1848;CA1873</NoWarn>
  </PropertyGroup>
</Project>
