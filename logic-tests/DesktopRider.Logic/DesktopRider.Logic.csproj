<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compiles exactly the files Unity compiles, with the same language version (C# 9) and the same
    class library (.NET Standard 2.1), so the logic can be built and tested without the Unity editor.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>DesktopRider.Logic</AssemblyName>
    <RootNamespace>DesktopRider</RootNamespace>
    <!-- The version and other assembly details come from AssemblyInfo.cs, as they do in Unity. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\unity\Assets\DesktopRider\Scripts\Logic\**\*.cs" LinkBase="Logic" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same Newtonsoft.Json version that Unity's com.unity.nuget.newtonsoft-json 3.2.1 package ships. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
  </ItemGroup>

</Project>
